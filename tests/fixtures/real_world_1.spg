											],
											[
												"门店活动",
												"门店活动"
											]
										],
										"notNull": false,
										"dimension": "model11",
										"margin": "15px",
										"height": "auto",
										"minHeight": "35px",
										"dimProperty": "model11.carBrand",
										"showRootItems": false,
										"disable": "false",
										"disableCondition": "combobox12.value= NULL",
										"enableCleanValue": true,
										"itemFilter": "isSales='在售'",
										"multiple": true,
