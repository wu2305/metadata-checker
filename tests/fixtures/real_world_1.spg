{
	"version": "4.19.7",
	"theme": "default",
	"params": [
		{
			"id": "param1",
			"name": "act_id",
			"includeAllWhenEmpty": true,
			"desc": "活动id"
		},
		{
			"id": "param2",
			"name": "spdm",
			"desc": "商品代码"
		},
		{
			"id": "param3",
			"name": "hdspdm",
			"desc": "活动商品代码"
		},
		{
			"id": "param4",
			"name": "ewm",
			"desc": "二维码"
		},
		{
			"id": "param5",
			"name": "tpid",
			"desc": "图片id"
		},
		{
			"id": "param6",
			"name": "sck",
			"value": "0",
			"desc": "素材库"
		},
		{
			"id": "param7",
			"name": "xcxewm",
			"includeAllWhenEmpty": true,
			"desc": "小程序二维码"
		},
		{
			"id": "param8",
			"name": "hdkqid",
			"desc": "活动卡券id"
		}
	],
	"sources": [
		{
			"id": "model2",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_activity.tbl",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false
		},
		{
			"id": "model3",
			"modelType": "dwtable",
			"path": "$DATA:/活动/维表/dim_campaignType.tbl"
		},
		{
			"id": "model5",
			"modelType": "dwtable",
			"path": "$DATA:/主数据/fact_customAutoStorefront.tbl"
		},
		{
			"id": "model6",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_activityGoods.tbl",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model6.activity.name=input7.value"
					}
				]
			}
		},
		{
			"id": "model7",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_goods.tbl"
		},
		{
			"id": "model8",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_goods.tbl",
			"name": "商品带出",
			"dataSetResultType": "oneRowResult",
			"queryConditionReturnEmpty": false
		},
		{
			"id": "model4",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_autoBasicMaterial.tbl",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"leftExp": "model4.materialType",
						"operator": "=",
						"rightValue": "1"
					}
				]
			}
		},
		{
			"id": "model9",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_autoBasicMaterial.tbl",
			"name": "选择的素材",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model9.file_id IN param5"
					}
				]
			},
			"dataSetResultType": "oneRowResult",
			"primaryKey": "file_id",
			"queryConditionReturnEmpty": false
		},
		{
			"id": "model10",
			"modelType": "dwtable",
			"path": "$DATA:/主数据/fact_productBrand.tbl",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"leftExp": "model10.enableStatus",
						"operator": "==",
						"rightValue": "1"
					}
				]
			}
		},
		{
			"id": "model11",
			"modelType": "dwtable",
			"path": "$DATA:/主数据/fact_product.tbl"
		},
		{
			"id": "model12",
			"modelType": "dwtable",
			"path": "$DATA:/主数据/fact_productCategory.tbl",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"leftExp": "model12.enableStatus",
						"operator": "=",
						"rightValue": "1"
					}
				]
			}
		},
		{
			"id": "model13",
			"modelType": "dwtable",
			"path": "$DATA:/通用/dim_Promoter.tbl",
			"primaryKey": "PromoterID",
			"queryConditionReturnEmpty": false,
			"cacheMode": "disable"
		},
		{
			"id": "model14",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_activityAttachment.tbl",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "HDID",
			"queryConditionReturnEmpty": false,
			"cacheMode": "disable",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model14.HDID = param1"
					}
				]
			}
		},
		{
			"id": "model1",
			"modelType": "dwtable",
			"path": "$DATA:/活动/fact_activity.tbl",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false,
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model1.name=input7.value"
					}
				]
			},
			"name": "活动1"
		},
		{
			"id": "model16",
			"modelType": "dwtable",
			"path": "$DATA:/活动/系统表勿动/取门店店总.tbl",
			"dataSetResultType": "oneRowResult",
			"queryConditionReturnEmpty": false,
			"params": [
				{
					"name": "groupid",
					"value": "${combobox8.value}"
				}
			]
		},
		{
			"id": "model15",
			"modelType": "workflow",
			"name": "流程表单数据",
			"workFlowSourceType": "formdata",
			"workFlowPath": "工作流/活动审批.wfl",
			"formId": "model1",
			"enableBusinessKeyExp": false,
			"inheritFieldVisible": false
		},
		{
			"id": "model17",
			"modelType": "dwtable",
			"path": "$DATA:/活动/活动卡券/fact_chooseActiveCard.tbl",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model17.hdName=input7.value"
					}
				]
			}
		},
		{
			"id": "model18",
			"modelType": "dwtable",
			"path": "$DATA:/活动/系统表勿动/取售后经理.tbl",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "USER_ID",
			"queryConditionReturnEmpty": false,
			"params": [
				{
					"name": "ssjg",
					"value": "=$user.dept_id"
				}
			]
		},
		{
			"id": "model19",
			"modelType": "dwtable",
			"path": "$DATA:/活动/系统表勿动/取门店财务经理.tbl",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "USER_ID",
			"queryConditionReturnEmpty": false,
			"params": [
				{
					"name": "ssjg",
					"value": "=$user.dept_id"
				}
			]
		}
	],
	"refComponentTypes": [
		"canvas",
		"panel",
		"steps",
		"panelbook",
		"combobox",
		"input",
		"button",
		"text",
		"multipleinput",
		"datecombobox",
		"numberinput",
		"list",
		"icon",
		"upload",
		"floatpanel",
		"image",
		"richtextinput",
		"dialog",
		"checkbox"
	],
	"canvas": {
		"id": "canvas",
		"type": "canvas",
		"viewSize": "entireView",
		"width": "100%",
		"minWidth": "600px",
		"height": "100%",
		"minHeight": "500px",
		"overflow": "hidden",
		"position": "default",
		"components": [
			{
				"id": "panel16",
				"type": "panel",
				"width": "100%",
				"minWidth": "20px",
				"height": "15%",
				"display": "inlineflexRow",
				"flexDirection": "row",
				"templateName": "panel_row",
				"components": [
					{
						"id": "steps1",
						"type": "steps",
						"width": "100%",
						"height": "100%",
						"defaultStep": "选择活动类型",
						"steps": [
							{
								"id": "step1",
								"type": "steps.step",
								"value": "选择活动类型",
								"desc": ""
							},
							{
								"id": "step2",
								"type": "steps.step",
								"value": "填写活动信息",
								"desc": ""
							},
							{
								"id": "step3",
								"type": "steps.step",
								"value": "选择活动素材",
								"desc": ""
							},
							{
								"id": "step4",
								"type": "steps.step",
								"value": "邀请意向客户",
								"visible": "false"
							}
						],
						"templateName": "steps",
						"margin": "0px",
						"stepsLayout": "horizontal",
						"stepsAlign": "center",
						"stepStyle": {
							"fontCaption": {
								"bold": true,
								"size": 16
							}
						},
						"numberStyle": {
							"fontStepNumber": {
								"size": 16
							}
						},
						"fill": "bg1"
					}
				],
				"margin": "0px 0px 10px 0px"
			},
			{
				"id": "panelbook1",
				"type": "panelbook",
				"width": "100%",
				"height": "85%",
				"panels": [
					{
						"id": "panel1",
						"type": "panelbook.panel",
						"panelName": "panel1",
						"components": [
							{
								"id": "panel17",
								"type": "panel",
								"width": "100%",
								"height": "85%",
								"templateName": "panel",
								"components": [
									{
										"id": "panel26",
										"type": "panel",
										"width": "auto",
										"minWidth": "20px",
										"height": "auto",
										"minHeight": "26px",
										"display": "inlineflexRow",
										"flexDirection": "row",
										"templateName": "panel_row",
										"components": [
											{
												"id": "combobox12",
												"type": "combobox",
												"width": "240px",
												"templateName": "combobox",
												"title": {
													"type": "title",
													"value": "业务类型\n",
													"font": {
														"color": "#000000"
													}
												},
												"submitData": true,
												"autoFilter": false,
												"options": [
													[
														"集团活动",
														"集团活动"
													],
													[
														"门店活动",
														"门店活动"
													]
												],
												"notNull": true,
												"dimension": "model2.entityType",
												"height": "auto",
												"minHeight": "35px",
												"actions": [
													{
														"id": "action1",
														"actionType": "setComponentProperty",
														"triggerType": "change",
														"compId": "combobox9",
														"propertyName": "value",
														"propertyValue": "NULL"
													},
													{
														"id": "action2",
														"actionType": "newData",
														"triggerType": "change",
														"enabled": "condition",
														"submitRange": "component",
														"submitComponent": [
															"combobox7",
															"combobox18",
															"combobox8",
															"combobox3",
															"combobox1",
															"combobox13",
															"combobox16"
														]
													}
												],
												"submitField": "model2.entityType",
												"enableCleanValue": true
											},
											{
												"id": "combobox3",
												"type": "combobox",
												"width": "165px",
												"templateName": "combobox",
												"options": [
													[
														"否",
														"否"
													],
													[
														"是",
														"是"
													]
												],
												"enableCleanValue": false,
												"notNull": true,
												"visible": "condition",
												"visibleCondition": "combobox12.value='2'",
												"title": {
													"type": "title",
													"value": "是否卡券活动",
													"width": "auto"
												},
												"submitData": true,
												"autoFilter": false,
												"calcEnabled": true,
												"submitField": "model2.couponActivity",
												"exp": "IF(combobox12.value='2','否',NULL)"
											},
											{
												"id": "input19",
												"type": "input",
												"width": "240px",
												"templateName": "txtinput",
												"calcEnabled": true,
												"exp": "combobox8.value",
												"title": {
													"type": "title"
												},
												"visible": "false"
											}
										],
										"margin": "5px 10px 5px 10px"
									},
									{
										"id": "panel24",
										"type": "panel",
										"width": "auto",
										"minWidth": "20px",
										"height": "auto",
										"minHeight": "26px",
										"display": "inlineflexRow",
										"flexDirection": "row",
										"templateName": "panel_row",
										"components": [
											{
												"id": "combobox7",
												"type": "combobox",
												"width": "240px",
												"height": "auto",
												"minHeight": "35px",
												"templateName": "combobox",
												"title": {
													"type": "title",
													"value": "活动发起方",
													"font": {
														"color": "#000000"
													}
												},
												"submitData": true,
												"autoFilter": false,
												"notNull": true,
												"calcEnabled": true,
												"margin": "8px 15px 8px 8px",
												"options": [
													[
														"1",
														"集团"
													],
													[
														"2",
														"门店"
													]
												],
												"dimension": "model13",
												"dimProperty": "model13.PromoterID",
												"submitField": "model2.initiator",
												"enableCleanValue": true,
												"actions": [
													{
														"id": "action1",
														"actionType": "newData",
														"triggerType": "change",
														"submitRange": "component",
														"submitComponent": [
															"combobox18",
															"combobox8"
														]
													}
												],
												"disable": "condition",
												"disableCondition": "IF($user.dept_id!='00000000',TRUE,FALSE)",
												"exp": "IF($user.dept_id!='00000000','2',NULL)"
											},
											{
												"id": "combobox18",
												"type": "combobox",
												"width": "165px",
												"templateName": "combobox",
												"options": [
													[
														"否",
														"否"
													],
													[
														"是",
														"是"
													]
												],
												"enableCleanValue": false,
												"notNull": true,
												"visible": "condition",
												"visibleCondition": "combobox7.value='2'",
												"title": {
													"type": "title",
													"value": "是否跨门店",
													"width": "auto"
												},
												"submitData": true,
												"autoFilter": false,
												"submitField": "model2.ifnoStore",
												"calcEnabled": true,
												"exp": "IF(combobox7.value=1,NULL,'否')",
												"disable": "condition",
												"disableCondition": "combobox12.value=2 AND combobox7.value=2"
											},
											{
												"id": "combobox8",
												"type": "combobox",
												"width": "auto",
												"minWidth": "240px",
												"maxWidth": "600px",
												"templateName": "combobox",
												"title": {
													"type": "title",
													"value": "参与门店",
													"font": {
														"color": "#000000"
													}
												},
												"dimension": "model5",
												"submitData": true,
												"autoFilter": false,
												"notNull": true,
												"submitField": "model2.participateStore",
												"visible": "condition",
												"visibleCondition": "combobox7.value=1 OR combobox18.value='是'",
												"height": "auto",
												"minHeight": "35px",
												"multiple": true,
												"enableCleanValue": true,
												"selectAllEnable": true,
												"calcEnabled": true,
												"exp": "IF(combobox18='否',$user.dept_id.DEPT_ID)"
											},
											{
												"id": "input5",
												"type": "input",
												"width": "240px",
												"templateName": "txtinput",
												"calcEnabled": true,
												"exp": "$user.dept_id.DEPT_ID",
												"submitData": true,
												"autoFilter": false,
												"submitField": "model2.dimDepart",
												"visible": "false",
												"title": {
													"type": "title",
													"value": "所属机构"
												}
											}
										],
										"margin": "5px 10px 5px 10px"
									},
									{
										"id": "panel25",
										"type": "panel",
										"width": "auto",
										"minWidth": "20px",
										"height": "auto",
										"minHeight": "26px",
										"display": "inlineflexRow",
										"flexDirection": "row",
										"templateName": "panel_row",
										"components": [
											{
												"id": "combobox9",
												"type": "combobox",
												"width": "240px",
												"templateName": "combobox",
												"title": {
													"type": "title",
													"value": "活动类型",
													"font": {
														"color": "#000000"
													}
												},
												"submitData": true,
												"autoFilter": false,
												"options": [
													[
														"集团活动",
														"集团活动"
													],
													[
														"门店活动",
														"门店活动"
													]
												],
												"notNull": true,
												"margin": "8px 15px 8px 8px",
												"height": "auto",
												"minHeight": "35px",
												"showRootItems": false,
												"disable": "condition",
												"disableCondition": "combobox12.value= NULL",
												"actions": [
													{
														"id": "action1",
														"actionType": "newData",
														"triggerType": "change",
														"submitRange": "component",
														"submitComponent": [
															"combobox1",
															"combobox13",
															"combobox16"
														]
													}
												],
												"enableCleanValue": true,
												"dimension": "model3",
												"itemFilter": "CASE WHEN combobox12.value IN ('2','4')\nTHEN id IN ('1','2','3')\nWHEN combobox12.value ='3'\nTHEN id IN ('1','2','3','5')\nWHEN combobox12.value ='1'\nTHEN id IN ('1','2','3','4')\nEND",
												"dimProperty": "model3.id",
												"submitField": "model2.campaignType"
											},
											{
												"id": "input10",
												"type": "input",
												"width": "181px",
												"templateName": "txtinput",
												"calcEnabled": true,
												"exp": "TOSTR(NOW(),'ddhhmmss')",
												"visible": "false",
												"title": {
													"type": "title",
													"value": "日期",
													"width": "auto"
												}
											},
											{
												"id": "input18",
												"type": "input",
												"width": "240px",
												"templateName": "txtinput",
												"calcEnabled": true,
												"exp": "SEQNUM(0)",
												"visible": "false",
												"title": {
													"type": "title",
													"value": "自增"
												}
											}
										],
										"margin": "5px 10px 5px 10px"
									},
									{
										"id": "input7",
										"type": "input",
										"width": "auto",
										"templateName": "txtinput",
										"title": {
											"type": "title",
											"value": "活动ID"
										},
										"calcEnabled": true,
										"exp": "CONCAT(input10,input18)",
										"submitData": true,
										"autoFilter": false,
										"submitField": "model2.name",
										"visible": "false"
									},
									{
										"id": "combobox1",
										"type": "combobox",
										"width": "370px",
										"templateName": "combobox",
										"title": {
											"type": "title",
											"value": "意向品牌",
											"font": {
												"color": "#000000"
											}
										},
										"submitData": true,
										"autoFilter": false,
										"options": [
											[
