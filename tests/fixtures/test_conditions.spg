{
    "version": "4.19.7",
    "theme": "default",
    "params": [
        {"id": "param1", "name": "参数A"}
    ],
    "sources": [
        {
            "id": "model1",
            "modelType": "dwtable",
            "path": "data/table1.tbl",
            "filter": {
                "scope": "self",
                "matchAll": true,
                "clauses": [
                    {"exp": "model1.status = 'active'"},
                    {"leftExp": "model1.dept_id", "operator": "=", "rightValue": "$user.dept_id"}
                ]
            }
        },
        {
            "id": "model2",
            "modelType": "query",
            "path": "data/query1.tbl"
        }
    ],
    "canvas": {
        "id": "canvas",
        "type": "canvas",
        "components": [
            {
                "id": "input1",
                "type": "input",
                "value": "=param1",
                "defaultValue": "=IF(param1 IS NULL, 'default', param1)",
                "visibleCondition": "=input1.value > 0"
            },
            {
                "id": "button1",
                "type": "button",
                "value": "提交",
                "disableCondition": "=input1.value IS NULL",
                "actions": [
                    {
                        "id": "action1",
                        "actionType": "submitData",
                        "triggerType": "click",
                        "conditionExp": "=input1.value == 'test'",
                        "submitRange": "component",
                        "submitComponent": ["input1"]
                    }
                ]
            },
            {
                "id": "文本统计",
                "type": "text",
                "value": "=model1.totalRowCount__"
            },
            {
                "id": "panel1",
                "type": "panel",
                "visibleCondition": "=$user.dept_id = '001'",
                "components": [
                    {
                        "id": "input2",
                        "type": "input",
                        "exp": "=CONCAT(input1.value, '-suffix')",
                        "enable": "=input1.value > 0"
                    }
                ]
            }
        ]
    }
}
