{
    "version": "4.19.7",
    "theme": "default",
    "sources": [
        {
            "id": "model6",
            "modelType": "dwtable",
            "path": "$DATA:/主数据/fact_qwSidebar.tbl"
        }
    ],
    "canvas": {
        "id": "canvas",
        "type": "canvas",
        "components": [
            {
                "id": "inputA",
                "type": "input",
                "value": "=model6.phoneNumber"
            },
            {
                "id": "buttonUpdate",
                "type": "button",
                "value": "更新",
                "actions": [
                    {
                        "id": "actionUpdate",
                        "actionType": "updateData",
                        "triggerType": "click",
                        "dataSet": "model6",
                        "fieldValues": [
                            {"name": "phoneNumber", "value": "=inputA.value", "valueType": "exp"}
                        ]
                    }
                ]
            }
        ]
    }
}
