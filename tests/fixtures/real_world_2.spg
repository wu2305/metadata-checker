		{
			"id": "model1",
			"modelType": "dwtable",
			"path": "$DATA:/销售/fact_Carpurchaseloanconsultationagency.tbl",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false,
			"cacheMode": "disable",
			"name": "购车贷款咨询代办提交"
		},
		{
			"id": "model2",
			"modelType": "dwtable",
			"path": "$DATA:/主数据/fact_customAutoStorefront.tbl",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "dimDepart",
			"queryConditionReturnEmpty": false,
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model2.dimDepart=input30"
					}
				]
			}
		},
		{
			"id": "model3",
			"modelType": "dwtable",
			"path": "$DATA:/销售/fact_Carpurchaseloanconsultationagency.tbl",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false,
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "TOSTR(model3.creat_time,'yyyymmdd')=TOSTR(TODAY(),'yyyymmdd')"
					}
				]
			},
			"name": "购车贷款咨询代办过滤今天"
		},
		{
			"id": "model4",
			"modelType": "dwtable",
			"path": "$DATA:/销售/加工表/购车贷款咨询代办.tbl",
			"name": "购车贷款咨询代办加工",
			"dataSetResultType": "oneRowResult",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false,
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "IF(model4.CANCELLATIONCONTRACT IS NULL,model4.SFQS=0,model4.SFQS!=0)"
					}
				]
			},
			"params": [
				{
					"name": "phone1",
					"value": "${param3}"
				}
			]
		},
		{
			"id": "model5",
			"modelType": "dwtable",
			"path": "$DATA:/销售/fact_Carpurchaseloanconsultationagency.tbl",
			"primaryKey": "name",
			"queryConditionReturnEmpty": false,
			"cacheMode": "disable",
			"name": "购车贷款咨询代办编辑",
			"dataSetResultType": "oneRowResult",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model5.externalUserId=param5"
					},
					{
						"exp": "model5.qwContactId=param6"
					},
					{
						"exp": "model5.signed IS NULL"
					},
					{
						"exp": "model5.creat_time.date=TODAY()"
					},
					{
						"exp": "model5.CANCELLATIONCONTRACT IS NULL"
					}
				]
			}
		},
