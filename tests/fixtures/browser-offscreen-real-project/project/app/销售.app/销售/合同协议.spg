			"name": "购车贷款咨询代办预览",
			"modelType": "dataflow",
			"dataSetResultType": "oneRowResult",
			"queryConditionReturnEmpty": false,
			"cacheMode": "disable",
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "model17.EXTERNALUSERID=param5"
					},
					{
						"exp": "model17.QWCONTACTID=text41"
					},
					{
						"exp": "model17.SIGNED IS NOT NULL"
					},
					{
						"exp": "model17.CANCELLATIONCONTRACT IS NULL OR model17.CANCELLATIONCONTRACT=''"
					}
				]
			}
