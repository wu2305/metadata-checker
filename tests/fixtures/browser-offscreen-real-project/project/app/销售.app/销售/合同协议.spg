																				"valueType": "exp",
																				"value": "CONCAT(IF(checkbox1.value=1 AND model40.CONTRACTNUMBER!=NULL ,model40.CONTRACTNUMBER,''),\nIF((checkbox1.value=1 AND model40.CONTRACTNUMBER!=NULL ) AND ((checkbox2.value=1 AND model42.NAME!=NULL)  OR (checkbox3.value=1 AND model43.NAME!=NULL ) OR (checkbox4.value=1 AND model44.NAME!=NULL) OR (checkbox5.value=1 AND model45.NAME!=NULL) OR (checkbox6.value=1 AND model46.NAME!=NULL) OR (checkbox7.value=1 AND model47.NAME!=NULL) OR (checkbox8.value=1 AND model48.NAME!=NULL)),',',''),\nIF(checkbox2.value=1 AND model42.NAME!=NULL ,model42.NAME,''),\nIF((checkbox2.value=1 AND model42.NAME!=NULL)  AND ((checkbox3.value=1 AND model43.NAME!=NULL ) OR (checkbox4.value=1 AND model44.NAME!=NULL) OR (checkbox5.value=1 AND model45.NAME!=NULL) OR (checkbox6.value=1 AND model46.NAME!=NULL) OR (checkbox7.value=1 AND model47.NAME!=NULL) OR (checkbox8.value=1 AND model48.NAME!=NULL)),',',''),\nIF(checkbox3.value=1 AND model43.NAME!=NULL ,model43.NAME,''),\nIF((checkbox3.value=1 AND model43.NAME!=NULL ) AND ((checkbox4.value=1 AND model44.NAME!=NULL) OR (checkbox5.value=1 AND model45.NAME!=NULL) OR (checkbox6.value=1 AND model46.NAME!=NULL) OR (checkbox7.value=1 AND model47.NAME!=NULL) OR (checkbox8.value=1 AND model48.NAME!=NULL)),',',''),\nIF(checkbox4.value=1 AND model44.NAME!=NULL ,model44.NAME,''),\nIF((checkbox4.value=1 AND model44.NAME!=NULL) AND ((checkbox5.value=1 AND model45.NAME!=NULL) OR (checkbox6.value=1 AND model46.NAME!=NULL) OR (checkbox7.value=1 AND model47.NAME!=NULL) OR (checkbox8.value=1 AND model48.NAME!=NULL)),',',''),\nIF(checkbox5.value=1 AND model45.NAME!=NULL ,model45.NAME,''),\nIF((checkbox5.value=1 AND model45.NAME!=NULL) AND ((checkbox6.value=1 AND model46.NAME!=NULL) OR (checkbox7.value=1 AND model47.NAME!=NULL) OR (checkbox8.value=1 AND model48.NAME!=NULL)),',',''),\nIF(checkbox6.value=1 AND model46.NAME!=NULL ,model46.NAME,''),\nIF((checkbox6.value=1 AND model46.NAME!=NULL) AND ((checkbox7.value=1 AND model47.NAME!=NULL) OR (