																				"value": "$user.id"
																			},
																			{
																				"name": "SignatoryName",
																				"valueType": "exp",
																				"value": "CASE WHEN checkbox1.value=1 AND model40.ZBNAME='0' THEN model40.BUYERNAME\nWHEN checkbox1.value=1 AND model40.ZBNAME!='0' THEN model40.ZBNAME\nWHEN checkbox2.value=1 AND model42.ZBNAME='0' THEN model42.WTFXM\nWHEN checkbox2.value=1 AND model42.ZBNAME!='0' THEN model42.ZBNAME\nWHEN checkbox3.value=1 AND model43.ZBNAME='0' THEN model43.WTFXM\nWHEN checkbox3.value=1 AND model43.ZBNAME!='0' THEN model43.ZBNAME\nWHEN checkbox4.value=1 AND model44.ZBNAME='0' THEN model44.WTFXM\nWHEN checkbox4.value=1 AND model44.ZBNAME!='0' THEN model44.ZBNAME\nWHEN checkbox5.value=1 AND model45.ZBNAME='0' THEN model45.ACCOUNT\nWHEN checkbox5.value=1 AND model45.ZBNAME!='0' THEN model45.ZBNAME\nWHEN checkbox6.value=1 AND model46.ZBNAME='0' THEN model46.KHXM\nWHEN checkbox6.value=1 AND model46.ZBNAME!='0' THEN model46.ZBNAME\nWHEN checkbox7.value=1 AND model47.ZBNAME='0' THEN model47.KHXM\nWHEN checkbox7.value=1 AND model47.ZBNAME!='0' THEN model47.ZBNAME\nWHEN checkbox8.value=1 AND model48.KHXM='0' THEN model48.KHXM\nWHEN checkbox8.value=1 AND model48.KHXM!='0' THEN model48.ZBNAME\nEND"
																			},
																			{
																				"name": "SignatoryPhone",
																				"valueType": "exp",
																				"value": "CASE WHEN checkbox1.value=1 AND model40.INDICATORPERSON='0' THEN model40.BUYERCONTACT\nWHEN checkbox1.value=1 AND model40.INDICATORPERSON!='0' THEN model40.INDICATORPERSON\nWHEN checkbox2.value=1 AND model42.INDICATORPERSON='0' THEN model42.PRINCIPAL_PHONE\nWHEN checkbox2.value=1 AND model42.INDICATORPERSON!='0' THEN model42.INDICATORPERSON\nWHEN checkbox3.value=1 AND model43.INDICATORPERSON='0' THEN model43.PRINCIPAL_PHONE\nWHEN checkbox3.value=1 AND model43.INDICATORPERSON!='0' THEN model43.INDICATORPERSON\nWHEN checkbox4.value=1 AND model44.INDICATORPERSON='0' THEN model44.PRINCIPAL_PHONE\nWHEN checkbox4.value=1 AND model44.INDICATORPERSON!='0' THEN model44.INDICATORPERSON\nWHEN checkbox5.value=1 AND model45.INDICATORPERSON='0' THEN model45.PHONE\nWHEN checkbox5.value=1 AND model45.INDICATORPERSON!='0' THEN model45.INDICATORPERSON\nWHEN checkbox6.value=1 AND model46.INDICATORPERSON='0' THEN model46.BUYERCONTACT\nWHEN checkbox6.value=1 AND model46.INDICATORPERSON!='0' THEN model46.INDICATORPERSON\nWHEN checkbox7.value=1 AND model47.INDICATORPERSON='0' THEN model47.PHONE\nWHEN checkbox7.value=1 AND model47.INDICATORPERSON!='0' THEN model47.INDICATORPERSON\nWHEN checkbox8.value=1 AND model48.INDICATORPERSON='0' THEN model48.PHONE\nWHEN checkbox8.value=1 AND model48.INDICATORPERSON!='0' THEN model48.INDICATORPERSON\nEND"
																			},
																			{
																				"name": "assignedSealId",
																				"valueType": "exp",
																				"value": "CASE WHEN checkbox1.value=1 THEN model40.ASSIGNEDSEALID\nWHEN checkbox2.value=1 THEN model42.ASSIGNEDSEALID\nWHEN checkbox3.value=1 THEN model43.ASSIGNEDSEALID\nWHEN checkbox4.value=1 THEN model44.ASSIGNEDSEALID\nWHEN checkbox5.value=1 THEN model45.ASSIGNEDSEALID\nWHEN checkbox6.value=1 THEN model46.ASSIGNEDSEALID\nWHEN checkbox7.value=1 THEN model47.ASSIGNEDSEALID\nWHEN checkbox8.value=1 THEN model48.ASSIGNEDSEALID\nEND\n"
																			},
																			{
																				"name": "fileType",
																				"valueType": "exp",
																				"value": "CASE WHEN checkbox1.value=1 THEN '销售合同'\nELSE '无销售合同'\nEND\n"
																			},
																			{
																				"name": "SIGNATORY",
																				"valueType": "exp",
																				"value": "CASE WHEN checkbox1.value=1 THEN model40.SIGNATORY\nWHEN checkbox2.value=1 THEN model42.SIGNATORY\nWHEN checkbox3.value=1 THEN model43.SIGNATORY\nWHEN checkbox4.value=1 THEN model44.SIGNATORY\nWHEN checkbox5.value=1 THEN model45.SIGNATORY\nWHEN checkbox6.value=1 THEN model46.SIGNATORY\nWHEN checkbox7.value=1 THEN model47.SIGNATORY\nWHEN checkbox8.value=1 THEN model48.SIGNATORY\nEND"
																			},
																			{
