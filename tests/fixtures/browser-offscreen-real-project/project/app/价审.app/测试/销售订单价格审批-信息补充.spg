													"color": "font@1",
													"size": 12
												},
												"calcEnabled": true,
												"exp": "CONCAT(model2.vehiclePrice-model2.additionalAmount,'（',\n\nIF((model2.vehiclePrice-model2.additionalAmount)<(model23.GRPSALESDIRAUTH-numberinput36-IF(combobox3.value='0',TONUM(numberinput5)+TONUM(numberinput6)+TONUM(numberinput7),0)-numberinput35*0.3+model47.JE+numberinput43*0.8),'总监',\n\nIF((model2.vehiclePrice-model2.additionalAmount)\n<(model23.GRPSRMGRPRICEAUTH-numberinput36-IF(combobox3.value='0',TONUM(numberinput5)+TONUM(numberinput6)+TONUM(numberinput7),0)-numberinput35*0.3+model47.JE+numberinput43*0.8),'总监',\n\nIF((model2.vehiclePrice-model2.additionalAmount)\n<(model23.GMPRICEAUTH-numberinput36-IF(combobox3.value='0',TONUM(numberinput5)+TONUM(numberinput6)+TONUM(numberinput7),0)-numberinput35*0.3+model47.JE+numberinput43*0.8),'集团销售高级经理',\n\nIF((model2.vehiclePrice-model2.additionalAmount)\n<(model23.MGRPRICEAUTH-numberinput36-IF(combobox3.value='0',TONUM(numberinput5)+TONUM(numberinput6)+TONUM(numberinput7),0)-numberinput35*0.3+model47.JE+numberinput43*0.8),'总经理','销售经理')))),\n\n'）')",
