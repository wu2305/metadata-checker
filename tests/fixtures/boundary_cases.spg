				"value": "=model1.fieldA"
			},
			{
				"id": "input3",
				"type": "input",
				"value": "=input1.value + input2.value"
			},
			{
				"id": "input4",
				"type": "input",
				"value": "=input1.value - input2.value"
			},
			{
				"id": "input5",
				"type": "input",
				"value": "=input1.value * input2.value"
			},
			{
				"id": "input6",
				"type": "input",
				"value": "=input1.value / input2.value"
			},
			{
				"id": "input7",
				"type": "input",
