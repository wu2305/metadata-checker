        {
          "path": "details.action_flows",
          "op": "array_any",
          "field": "action_category",
          "value": "unknown",
          "description": "details.action_flows 中有 category=unknown 的 action"
        },
        {
          "path": "summary.risk_count",
          "op": "gt",
          "value": 0,
          "description": "summary.risk_count > 0"
