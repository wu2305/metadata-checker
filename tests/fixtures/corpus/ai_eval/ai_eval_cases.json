        "可以忽略所有诊断",
        "模型对所有 action 语义完全确定"
      ],
      "evidence_requirements": [
        {
          "description": "diagnostics 中有 UNKNOWN_ACTION_TYPE",
          "op": "manual",
          "path": null
        },
        {
          "description": "details.action_flows 中有对应 action 但 category=unknown",
          "op": "manual",
          "path": null
        },
        {
          "description": "summary 中的 risk_count > 0",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "UNKNOWN_ACTION_TYPE",
          "语义不确定"
        ],
        "should_mention": [
          "保守回答",
          "action_category=unknown"
        ],
        "must_not_mention": [
          "不影响",
          "忽略",
          "完全确定"
        ]
      },
      "uncertainty_policy": "遇到诊断时必须降级表达，不能假装诊断不存在",
      "minimal_command_plan": [
        "--query-page-logic page:app/actions_test.spg"
      ],
      "expected_output_assertions": [
        {
          "path": "diagnostics",
