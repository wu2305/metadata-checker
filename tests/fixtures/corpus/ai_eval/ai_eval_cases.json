{
  "schema_version": "1.1.0",
  "scope": "M9-D AI 问答评测集：验证空上下文小模型基于 SKILL.md + CLI 输出回答真实业务问题的能力",
  "eval_count": 10,
  "cases": [
    {
      "case_id": "page_purpose_actions_test",
      "question": "页面 actions_test 主要做什么？用户能触发哪些逻辑？会影响哪些数据？",
      "project_dir": "tests/fixtures/test_project",
      "required_commands": [
        "--project-dir tests/fixtures/test_project --query-page-logic page:app/actions_test.spg"
      ],
      "expected_facts": [
        "页面是 actions_test",
        "有多个用户入口（按钮）",
        "按钮可以提交数据到 model1",
        "按钮可以删除 model2 数据",
        "有弹窗（showDialog/closeDialog）操作",
        "有切换面板（switchPanel）操作"
      ],
      "forbidden_claims": [
        "页面是只读的",
        "没有任何写入操作",
        "用户无法触发任何逻辑"
      ],
      "evidence_requirements": [
        {
          "path": "summary.entrypoint_count",
          "op": "gt",
          "value": 0,
          "description": "summary.entrypoint_count > 0"
        },
        {
          "path": "summary.write_target_count",
          "op": "gt",
          "value": 0,
          "description": "summary.write_target_count > 0"
        },
        {
          "description": "details.action_flows 非空",
          "op": "manual",
          "path": null
        },
        {
          "description": "存在 action_category=data_write 的 action",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "用户入口数量",
          "写入目标",
          "action 类型"
        ],
        "should_mention": [
          "弹窗",
          "切换面板"
        ],
        "must_not_mention": [
          "只读",
          "无写入"
        ]
      },
      "uncertainty_policy": "如果诊断中有 UNKNOWN_ACTION_TYPE，应标注该 action 语义不确定",
      "minimal_command_plan": [
        "--query-page-logic page:app/actions_test.spg"
      ],
      "expected_output_assertions": [
        {
          "path": "summary.entrypoint_count",
          "op": "gt",
          "value": 0,
          "description": "页面必须有用户入口"
        },
        {
          "path": "summary.write_target_count",
          "op": "gt",
          "value": 0,
          "description": "页面必须有写入目标"
        },
        {
          "path": "details.action_flows",
          "op": "not_empty",
          "description": "action_flows 非空"
        },
        {
          "path": "details.action_flows",
          "op": "array_any",
          "field": "action_category",
          "value": "data_write",
          "description": "存在 data_write 类别的 action"
        }
      ]
    },
    {
      "case_id": "button_submit_effect",
      "question": "点击 actions_test 页面中的 button1 会发生什么？",
      "project_dir": "tests/fixtures/test_project",
      "required_commands": [
        "--project-dir tests/fixtures/test_project --explain 'comp:app/actions_test.spg|button1'"
      ],
      "expected_facts": [
        "button1 是一个按钮组件",
        "button1 触发 action1",
        "action1 是 submitData 类型",
        "action1 写入 model1"
      ],
      "forbidden_claims": [
        "button1 没有动作",
        "button1 是只读的",
        "button1 读取数据但不写入"
      ],
      "evidence_requirements": [
        {
          "description": "summary.what_is_it 包含 button1",
          "op": "manual",
          "path": null
        },
        {
          "description": "details.writes 非空",
          "op": "manual",
          "path": null
        },
        {
          "description": "evidence 中有 ActionWrites 边",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "button1",
          "submitData",
          "model1"
        ],
        "should_mention": [
          "action1",
          "写入目标字段"
        ],
        "must_not_mention": [
          "只读",
          "无动作"
        ]
      },
      "uncertainty_policy": "如果 lineage 为空，应说明字段来源无法追溯",
      "minimal_command_plan": [
        "--explain 'comp:app/actions_test.spg|button1'"
      ],
      "expected_output_assertions": [
        {
          "path": "summary.what_is_it",
          "op": "contains",
          "value": "button1",
          "description": "summary 包含 button1"
        },
        {
          "path": "details.writes",
          "op": "not_empty",
          "description": "details.writes 非空"
        },
        {
          "path": "evidence",
          "op": "array_any",
          "field": "edge_type",
          "value": "ActionWrites",
          "description": "evidence 中有 ActionWrites 边"
        }
      ]
    },
    {
      "case_id": "field_lineage_model1_name",
      "question": "字段 model1.name 的值从哪里来？",
      "project_dir": "tests/fixtures/test_project",
      "required_commands": [
        "--project-dir tests/fixtures/test_project --explain field:model1.name"
      ],
      "expected_facts": [
        "model1.name 被页面 action 写入",
        "有 submitData/insertData/updateData 类型的 action 涉及该字段"
      ],
      "forbidden_claims": [
        "字段值完全无法确定来源",
        "字段是系统自动生成的，与用户无关",
        "字段只读，不能被写入"
      ],
      "evidence_requirements": [
        {
          "description": "summary 有 read_by_count/written_by_count",
          "op": "manual",
          "path": null
        },
        {
          "description": "evidence 中有 ActionWrites 或 Writes 边",
          "op": "manual",
          "path": null
        },
        {
          "description": "如果 lineage 为空，diagnostics 应有 LINEAGE_SOURCE_MISSING",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "写入者",
          "页面 action"
        ],
        "should_mention": [
          "submitData/insertData/updateData"
        ],
        "must_not_mention": [
          "只读",
          "来源完全未知"
        ]
      },
      "uncertainty_policy": "如果 lineage 链不完整，允许说\"写入者已知，但完整来源链未追溯\"",
      "minimal_command_plan": [
        "--explain field:model1.name"
      ],
      "expected_output_assertions": [
        {
          "path": "summary",
          "op": "contains_field_path",
          "field_path": "written_by_count",
          "description": "summary 有 written_by_count"
        },
        {
          "path": "evidence",
          "op": "array_any",
          "field": "edge_type",
          "value": "ActionWrites",
          "description": "evidence 中有 ActionWrites 或 Writes 边"
        },
        {
          "path": "evidence",
          "op": "array_any",
          "field": "edge_type",
          "value": "Writes",
          "description": "evidence 中有 Writes 边"
        }
      ]
    },
    {
      "case_id": "dataflow_output_source",
      "question": "DataFlow 输出表 dataflow_output 是怎么来的？",
      "project_dir": "tests/fixtures/test_project",
      "required_commands": [
        "--project-dir tests/fixtures/test_project --query-dataflow dataflow_output",
        "--project-dir tests/fixtures/test_project --explain model:dataflow_output"
      ],
      "expected_facts": [
        "dataflow_output 有输入源",
        "dataflow_output 有输出目标",
        "内部有节点拓扑（nodes/edges）"
      ],
      "forbidden_claims": [
        "DataFlow 没有输入",
        "DataFlow 没有输出",
        "dataflow_output 是孤立节点"
      ],
      "evidence_requirements": [
        {
          "description": "details.inputs_count > 0 或 details.outputs_count > 0",
          "op": "manual",
          "path": null
        },
        {
          "description": "details.internal_topology 非空",
          "op": "manual",
          "path": null
        },
        {
          "description": "evidence 有 OutputsTo 或 DataflowInput 边",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "输入源",
          "输出目标",
          "内部节点"
        ],
        "should_mention": [
          "链式 DataFlow"
        ],
        "must_not_mention": [
          "孤立",
          "无输入",
          "无输出"
        ]
      },
      "uncertainty_policy": "如果 lineage 不完整，应标注字段级追溯缺失",
      "minimal_command_plan": [
        "--query-dataflow dataflow_output",
        "--explain model:dataflow_output"
      ],
      "expected_output_assertions": [
        {
          "path": "evidence",
          "op": "not_empty",
          "description": "evidence 非空"
        },
        {
          "path": "summary",
          "op": "not_empty",
          "description": "summary 非空"
        },
        {
          "path": "details",
          "op": "not_empty",
          "description": "details 非空"
        }
      ]
    },
    {
      "case_id": "readonly_page_check",
      "question": "页面 dataflow_embedded 是只读的吗？用户能修改数据吗？",
      "project_dir": "tests/fixtures/test_project",
      "required_commands": [
        "--project-dir tests/fixtures/test_project --explain page:app/dataflow_embedded.spg"
      ],
      "expected_facts": [
        "页面是只读仪表板",
        "没有用户可触发入口",
        "没有写入操作",
        "没有 submitData/updateData/insertData/deleteData"
      ],
      "forbidden_claims": [
        "页面可以写入数据",
        "用户可以提交表单",
        "页面有数据修改入口"
      ],
      "evidence_requirements": [
        {
          "description": "summary.page_role 为 readonly_dashboard",
          "op": "manual",
          "path": null
        },
        {
          "path": "summary.write_target_count",
          "op": "eq",
          "value": 0,
          "description": "summary.write_target_count = 0"
        },
        {
          "path": "summary.entrypoint_count",
          "op": "eq",
          "value": 0,
          "description": "summary.entrypoint_count = 0"
        },
        {
          "description": "diagnostics 有 NO_ENTRYPOINTS 或 NO_WRITE_TARGETS",
          "op": "manual",
          "path": null
        }
      ],
      "answer_rubric": {
        "must_mention": [
          "只读",
          "无写入",
          "无入口"
        ],
        "should_mention": [
          "readonly_dashboard",
          "NO_WRITE_TARGETS"
        ],
        "must_not_mention": [
          "写入",
          "提交",
          "修改",
          "按钮"
        ]
      },
      "uncertainty_policy": "如果页面确实无任何 action，可明确回答只读",
      "minimal_command_plan": [
        "--explain page:app/dataflow_embedded.spg"
      ],
      "expected_output_assertions": [
        {
          "path": "summary.write_target_count",
          "op": "eq",
          "value": 0,
          "description": "summary.write_target_count = 0"
        },
        {
          "path": "summary.entrypoint_count",
          "op": "eq",
          "value": 0,
          "description": "summary.entrypoint_count = 0"
        },
        {
          "path": "diagnostics",
          "op": "array_any",
          "field": "code",
          "value": "NO_ENTRYPOINTS",
          "description": "diagnostics 有 NO_ENTRYPOINTS 或 NO_WRITE_TARGETS"
        }
      ]
    },
    {
