	"sources": [
		{
			"id": "model1",
			"modelType": "dwtable",
			"path": "$DATA:/销售/fact_newsaleContract.tbl",
			"customFields": [
				{
					"name": "待签署文件",
					"exp": "IF(notSigned is NOT NULL, CONCAT('销售合同-',fileName),NULL)",
					"dbfield": "CALCULATOR_1",
					"isDimension": true
				},
				{
					"name": "已签署文件",
					"exp": "IF(signed is NOT NULL, CONCAT('销售合同-',fileName),NULL)",
					"dbfield": "CALCULATOR_2",
					"isDimension": true
				}
			],
			"filter": {
				"scope": "self",
				"matchAll": true,
				"clauses": [
					{
						"exp": "IF(USER_INGROUP('Store_General_Manager') OR USER_INGROUP('Store_Sales_Manager'),model1.dimDepart = $user.dept_id,IF(USER_INGROUP('Store_Sales_Consultant'),model1.dimDepart = $user.dept_id AND model1.createName.USER_ID = $user.id,model1.dimDepart = $user.dept_id))"
					},
					{
						"exp": "model1.notSigned IS NOT NULL"
					}
				]
			}
		}
	],
	"refComponentTypes": [
		"canvas",
		"panel",
		"text",
		"fieldsFilter",
		"list",
		"button"
	],
